# Passed to the app with: flutter run --dart-define-from-file=.env
# Copy to .env (git-ignored) and fill in. Never commit real credentials.
APP_MODE=api
# Host only, no /api path: the app adds /api/v1/... itself.
# WorkFlow backend (2026-11-14): https://api.workflownets.com
API_BASE_URL=https://api.workflownets.com
